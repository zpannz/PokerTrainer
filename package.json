{
  "name": "poker-gto-trainer",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "gen:equity": "node --experimental-strip-types scripts/gen-equity-matrix.ts",
    "gen:nash": "node --experimental-strip-types scripts/gen-pushfold.ts",
    "verify:evaluator": "node --experimental-strip-types scripts/verify-evaluator.ts",
    "build:wasm": "cd solver && cargo build --release -p pt-solver-wasm --target wasm32-unknown-unknown && cp target/wasm32-unknown-unknown/release/pt_solver_wasm.wasm ../src/postflop/wasm/pt_solver.wasm",
    "test:solver": "cd solver && cargo test --release -p pt-solver-core",
    "gen:postflop-jobs": "vite-node scripts/gen-postflop-jobs.ts --",
    "gen:postflop-index": "vite-node scripts/build-postflop-index.ts",
    "bench:solver": "vite-node scripts/bench-solver.ts",
    "gen:reshove": "vite-node scripts/gen-reshove.ts"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/node": "22.10.2",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.7.2",
    "vite": "6.0.7",
    "vitest": "2.1.8"
  }
}
